          "constant": {"color": "#D2A6FF"},
          "constructor": {"color": "#95E6CB"},
          "embedded": {"color": "#BFBDB6"},
          "emphasis": {"font_style": "italic"},
          "emphasis.strong": {"font_weight": 700},
          "function": {"color": "#FFB454"},
          "keyword": {"color": "#FF8F40"},
          "link_text": {"color": "#59C2FF", "font_style": "normal"},
          "link_uri": {"color": "#59C2FF", "font_style": "italic"},
