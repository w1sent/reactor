          "property": {"color": "#95E6CB"},
          "string": {"color": "#AAD94C"},
          "string.escape": {"color": "#E6B450"},
          "string.regex": {"color": "#95E6CB"},
          "string.special": {"color": "#95E6CB"},
          "string.special.symbol": {"color": "#95E6CB"},
          "tag": {"color": "#39BAE6"},
          "text.literal": {"color": "#AAD94C"},
          "text.code.span": {"color": "#AAD94C"},
